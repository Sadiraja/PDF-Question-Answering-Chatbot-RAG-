# =====================================================================
# PDF Question-Answering Chatbot (RAG) - Environment Configuration
# =====================================================================

# OpenRouter API Key (Recommended - supports GPT-4o-mini, Gemini, Llama, Claude)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Google Gemini API Key (for gemini-2.5-flash / text-embedding-004)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (for gpt-4o-mini / text-embedding-3-small)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: HuggingFace Token (for higher download rate limits on SentenceTransformers)
HF_TOKEN=your_huggingface_token_here
